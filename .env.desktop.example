# Desktop gateway configuration. This file must never contain a DeepSeek API Key.
MEAL_AI_GATEWAY_URL=http://127.0.0.1:8787
# Use the same value as backend AI_GATEWAY_TOKEN when gateway token checking is enabled.
MEAL_AI_GATEWAY_TOKEN=
# The desktop client stores only this opaque session token; auth secrets stay on the backend.
MEAL_AUTH_API_URL=http://127.0.0.1:8787
