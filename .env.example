# Development conveniences (placeholder secrets, AUTH_EXPOSE_DEV_CODE) are only
# tolerated when NODE_ENV is exactly "development". Any other value — including
# leaving it unset — makes the server refuse to start until every secret below
# is a real one. Never set this on a deployed server.
NODE_ENV=development

# Upstream model service key pool. Keep this file only on the backend server.
# Separate multiple keys with commas or new lines. Never use VITE_* for secrets.
MEAL_AI_API_KEYS=replace_with_server_key_1,replace_with_server_key_2
AI_ASSIGNMENT_SECRET=replace-with-a-long-random-assignment-secret
# Optional shared gateway token for local testing. Leave empty or set the same value in .env.desktop.
AI_GATEWAY_TOKEN=

# Image API and PostgreSQL
IMAGE_API_PORT=8787
IMAGE_API_CORS_ORIGINS=http://localhost:5173,null
IMAGE_UPLOAD_TOKEN=replace-with-a-long-random-token
DATABASE_URL=postgresql://mealapp:mealapp_dev_password@127.0.0.1:55432/jintianchisha
POSTGRES_DB=jintianchisha
POSTGRES_USER=mealapp
POSTGRES_PASSWORD=mealapp_dev_password
POSTGRES_PORT=55432

# Auth/session settings. Secrets must be at least 24 characters and must not
# start with replace-/change-, otherwise the server refuses to start.
# AUTH_EXPOSE_DEV_CODE returns the verification code in the HTTP response, so it
# is opt-in only and blocks startup unless NODE_ENV=development.
AUTH_SESSION_SECRET=replace-with-a-long-random-auth-secret
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_VERIFICATION_TTL_SECONDS=300
AUTH_VERIFICATION_COOLDOWN_SECONDS=60
AUTH_EXPOSE_DEV_CODE=true
AUTH_DEV_CODE=123456
# OAuth2.0 is optional; leave empty until WeChat/QQ apps and callback URLs exist.
WECHAT_APP_ID=
WECHAT_REDIRECT_URI=
QQ_APP_ID=
QQ_REDIRECT_URI=

# Membership payments. Browser-facing code never receives these secrets.
# PAYMENT_NOTIFY_BASE_URL must be a public HTTPS origin in production.
PAYMENT_NOTIFY_BASE_URL=
PAYMENT_ORDER_TTL_MINUTES=15
# Protects manual refund/revocation administration endpoints. Never expose it
# to desktop or browser code.
BILLING_ADMIN_TOKEN=change-this-development-billing-admin-token
# Local development only: creates a no-charge test channel. Production refuses
# to start while this is true.
PAYMENT_DEV_SIMULATION=false

# WeChat Pay API v3 (Native payment)
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=

# Alipay face-to-face payment (precreate)
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# MinIO private object storage
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=mealapp_minio
MINIO_ROOT_PASSWORD=mealapp_minio_dev_password
MINIO_ACCESS_KEY=mealapp_minio
MINIO_SECRET_KEY=mealapp_minio_dev_password
MINIO_BUCKET=dish-images
MINIO_REGION=cn-north-1

# Renderer may read this public API base URL; never expose IMAGE_UPLOAD_TOKEN as VITE_*.
VITE_IMAGE_API_URL=http://127.0.0.1:8787
VITE_AUTH_API_URL=http://127.0.0.1:8787
